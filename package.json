{
  "name": "clanbot",
  "version": "1.0.16",
  "description": "Discord Bot for OpenFront.io clans with clan stats, FFA tournament points, custom currency, and automated rank roles",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy-commands": "node dist/deploy-commands.js",
    "build:obfuscate": "npm run build && tsx scripts/obfuscate.ts",
    "grab-token": "tsx scripts/grab-token.ts",
    "grab-token:sync": "tsx scripts/grab-token.ts --sync",
    "grab-token:daemon": "tsx scripts/grab-token.ts --daemon --sync"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.7",
    "puppeteer": "^25.13.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/puppeteer": "^5.4.7",
    "bytenode": "^1.7.0",
    "esbuild": "^0.28.2",
    "javascript-obfuscator": "^5.9.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "allowScripts": {
    "puppeteer@25.13.0": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
